# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/joyprep?schema=public

# JWT
JWT_SECRET=replace_with_secure_random
JWT_REFRESH_SECRET=replace_with_secure_random

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage (example for S3-compatible)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_KEY=
STORAGE_SECRET=

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Google Drive service account JSON path or credentials
GOOGLE_DRIVE_SERVICE_ACCOUNT=

# Payment provider placeholders
PAYMENT_PROVIDER=none
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
